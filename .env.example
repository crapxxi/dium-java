# Скопируйте этот файл в .env и заполните значения.
# .env подхватывается автоматически при локальном запуске (spring.config.import) и НЕ коммитится.

# --- JWT ---
# Base64-строка, минимум 32 байта. Сгенерировать: openssl rand -base64 48
JWT_KEY=

# --- WhatsApp (Green API) ---
# Только хост, без пути и без слэша в конце. Берётся из личного кабинета Green API (поле apiUrl),
# например https://api.green-api.com или https://7103.api.greenapi.com
WHATSAPP_API_URL=https://api.green-api.com
WHATSAPP_INSTANCE_ID=
WHATSAPP_API_TOKEN=

# --- Двухфакторная аутентификация ---
# Ключ AES-256 для шифрования TOTP-секретов: Base64 от 32 случайных байт.
# Сгенерировать: openssl rand -base64 32
# ВНИМАНИЕ: при смене ключа все настроенные TOTP перестанут работать.
TWO_FACTOR_ENCRYPTION_KEY=
# Обязательная 2FA для ролей ADMIN и VENUE_OWNER (true/false)
TWO_FACTOR_REQUIRED_FOR_STAFF=true

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- База данных (нужно только для prod-профиля; dev использует localhost:5432/diumdb) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/diumdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# --- Прочее ---
PORT=8080
